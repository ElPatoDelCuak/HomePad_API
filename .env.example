# ==========================================
# Configuración para Entorno Local
# ==========================================
# Conexión directa a PostgreSQL en local o mediante túnel SSH:
DATABASE_URL=postgresql://homepad_user:homepad_password@localhost:5432/homepad_db

# Si ejecutas la API dentro de Docker en local:
# DATABASE_URL=postgresql://homepad_user:homepad_password@host.docker.internal:5432/homepad_db

# ==========================================
# Configuración para el Servidor (Producción)
# ==========================================
# Conexión al contenedor compartido de Postgres en la misma red de Docker:
# DATABASE_URL=postgresql://homepad_user:homepad_password@shared_postgres:5432/homepad_db
